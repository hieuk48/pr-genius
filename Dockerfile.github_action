# Dockerfile for PR Genius GitHub Action
# Optimized for GitHub Actions environment

FROM python:3.12-slim

LABEL maintainer="zsxh1990 <445655361@qq.com>"
LABEL project="pr-genius"
LABEL description="PR Genius GitHub Action - Evidence-backed PR contribution advisor"
LABEL license="MIT"

# Install git (required for PR Genius)
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# Security: drop root — Action container processes untrusted PR data (title/body/diff_stat).
# Audit C.1: was running as root, which is fine in GH Actions (per-step isolation) but
# every Python dep in the env becomes a path to root if it has a CVE. Match the main
# `Dockerfile` (which already does this correctly).
RUN groupadd -r prgenius && useradd -r -g prgenius prgenius

WORKDIR /app

# Install prgenius-core from PyPI
RUN pip install --no-cache-dir prgenius-core

# Copy knowledge bundle data
COPY anti-patterns/ ./anti-patterns/
COPY success-patterns/ ./success-patterns/
COPY docs/ ./docs/
COPY index.md validate.py ./

# Copy entrypoint
COPY github_action/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python3 -m prgenius --version || exit 1

# Security: never run as root. Audit C.1 finding.
USER prgenius

ENTRYPOINT ["/entrypoint.sh"]
